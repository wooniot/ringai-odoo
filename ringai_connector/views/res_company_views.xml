<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_ringai" model="ir.ui.view">
        <field name="name">res.company.form.ringai</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="RingAI">
                    <field name="ringai_tenant_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
